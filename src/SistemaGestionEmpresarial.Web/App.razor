@* El router decide el acceso a cada ruta: a quien no ha iniciado sesión lo manda al login;
   a quien sí la tiene pero carece del permiso, le explica por qué no puede entrar. *@

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized Context="sesion">
                    @if (sesion.User.Identity?.IsAuthenticated == true)
                    {
                        <MensajeAccesoDenegado Rol="@sesion.User.ObtenerRol()" />
                    }
                    else
                    {
                        <RedirectToLogin />
                    }
                </NotAuthorized>
                <Authorizing>
                    <p class="router-estado" role="status">Verificando sus permisos…</p>
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Página no encontrada</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <div style="padding: 20px;">
                    <h3>Página no encontrada</h3>
                    <p role="alert">Lo sentimos, no hay nada en esta dirección.</p>
                    <a href="/" class="btn btn-secondary">Volver al inicio</a>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

<style>
    .router-estado {
        padding: 32px;
        text-align: center;
        color: var(--color-text-muted);
    }
</style>
