@page "/"
@implements IDisposable
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ProductosApiService ProductosApi
@inject ClientesApiService ClientesApi
@inject UsuariosApiService UsuariosApi
@inject CategoriasProductoApiService CategoriasApi

<PageTitle>Inicio - SGECAR</PageTitle>
<AuthorizeView Context="sesion">
    <Authorized>
        <div class="home-dashboard">
            <header class="dash-hero"><div><span class="dash-eyebrow">PANEL GENERAL</span><h1>Hola, @sesion.User.Identity?.Name</h1><p>Resumen de tu espacio de trabajo <span class="dash-role">@sesion.User.ObtenerRol()</span></p></div></header>
            @if (sesion.User.TienePermiso(Permisos.Consultar) || sesion.User.TienePermiso(Permisos.GestionarUsuarios) || sesion.User.TienePermiso(Permisos.GestionarCategorias))
            {
                <section aria-labelledby="resumen"><div class="dash-section-title"><span class="dash-eyebrow">VISTA GENERAL</span><h2 id="resumen">Resumen</h2></div>
                    <div class="dash-metrics">
                        <VistaConPermiso Permiso="@Permisos.Consultar"><article class="dash-metric"><span class="dash-icon blue">▣</span><span>Productos</span><strong>@Valor(productos, cargandoProductos, errorProductos)</strong><small>Registrados en el catálogo</small></article></VistaConPermiso>
                        <VistaConPermiso Permiso="@Permisos.Consultar"><article class="dash-metric"><span class="dash-icon purple">♧</span><span>Clientes</span><strong>@Valor(clientes, cargandoClientes, errorClientes)</strong><small>Registrados en el sistema</small></article></VistaConPermiso>
                        <VistaConPermiso Permiso="@Permisos.GestionarUsuarios"><article class="dash-metric"><span class="dash-icon green">♙</span><span>Usuarios activos</span><strong>@Valor(usuarios?.Count(u => u.Activo), cargandoUsuarios, errorUsuarios)</strong><small>Con acceso habilitado</small></article></VistaConPermiso>
                        <VistaConPermiso Permiso="@Permisos.GestionarCategorias"><article class="dash-metric"><span class="dash-icon amber">▤</span><span>Categorías</span><strong>@Valor(categorias, cargandoCategorias, errorCategorias)</strong><small>Tipos de producto</small></article></VistaConPermiso>
                    </div>
                    @if (errorClientes is not null || errorUsuarios is not null || errorCategorias is not null)
                    { <p class="dash-error" role="alert">Algunos datos no se pudieron cargar. Revisa la conexión e inténtalo de nuevo.</p> }
                </section>
            }
            <VistaConPermiso Permiso="@Permisos.Consultar">
                <section aria-labelledby="inventario"><div class="dash-section-title horizontal"><div><span class="dash-eyebrow">CONTROL DE EXISTENCIAS</span><h2 id="inventario">Inventario</h2></div><a href="administracion/productos">Ver productos →</a></div>
                    @if (cargandoProductos) { <div class="dash-panel dash-state" role="status">Cargando inventario…</div> }
                    else if (errorProductos is not null) { <div class="dash-panel dash-state dash-error" role="alert">No se pudo cargar el inventario. Comprueba la conexión e inténtalo de nuevo.</div> }
                    else if (productos is not null)
                    {
                        <div class="dash-inventory">
                            <article class="dash-panel"><h3>Estado del stock</h3><div class="dash-stock-summary"><div><span class="dash-stock-icon low">!</span><strong>@productos.Count(p => p.Stock is >= 1 and <= 5)</strong><span>Stock bajo<small>1 a 5 unidades</small></span></div><div><span class="dash-stock-icon out">×</span><strong>@productos.Count(p => p.Stock == 0)</strong><span>Agotados<small>0 unidades</small></span></div></div>
                                <h3 class="dash-subtitle">Menor disponibilidad</h3>
                                @if (productos.Count == 0) { <p class="dash-empty">Aún no hay productos registrados.</p> }
                                else { <div class="dash-table-wrap"><table><thead><tr><th>Producto</th><th>Categoría</th><th>Disponible</th></tr></thead><tbody>
                                    @foreach (var producto in productos.OrderBy(p => p.Stock).ThenBy(p => p.Nombre).Take(5)) { <tr><td>@producto.Nombre<small>@producto.Codigo</small></td><td>@producto.Categoria</td><td><span class="dash-stock-badge @ClaseStock(producto.Stock)">@producto.Stock</span></td></tr> }
                                </tbody></table></div>
                                @if (!productos.Any(p => p.Stock <= 5)) { <p class="dash-healthy">No hay productos con stock bajo ni agotados.</p> }
                                }
                            </article>
                            <article class="dash-panel"><h3>Productos por categoría</h3><p class="dash-muted">Distribución del catálogo actual</p>
                                @if (productos.Count == 0) { <p class="dash-empty">No hay datos para mostrar.</p> }
                                else { <div class="dash-bars" role="img" aria-label="Distribución de productos por categoría">
                                    @foreach (var grupo in productos.GroupBy(p => string.IsNullOrWhiteSpace(p.Categoria) ? "Sin categoría" : p.Categoria).OrderByDescending(g => g.Count()).ThenBy(g => g.Key)) { <div class="dash-bar-row"><div><span>@grupo.Key</span><strong>@grupo.Count()</strong></div><div class="dash-track"><span style="width:@(100.0 * grupo.Count() / productos.Count)%"></span></div></div> }
                                </div> }
                            </article>
                        </div>
                    }
                </section>
            </VistaConPermiso>
            <section aria-labelledby="acciones"><div class="dash-section-title"><span class="dash-eyebrow">ACCESOS DIRECTOS</span><h2 id="acciones">Acciones rápidas</h2></div><div class="dash-links">
                @if (sesion.User.TienePermiso(Permisos.Consultar) && sesion.User.TienePermiso(Permisos.Agregar)) { <a href="administracion/productos" title="Abre Productos y selecciona Nuevo producto"><span>＋</span><span><strong>Nuevo producto</strong><small>Desde el módulo de productos</small></span><b>→</b></a> }
                <VistaConPermiso Permiso="@Permisos.Consultar"><a href="administracion/productos"><span>▣</span><span><strong>Consultar productos</strong><small>Explorar el catálogo</small></span><b>→</b></a><a href="reportes/productos"><span>▤</span><span><strong>Generar reporte</strong><small>Reporte de productos</small></span><b>→</b></a></VistaConPermiso>
                @if (sesion.User.TienePermiso(Permisos.Consultar) && sesion.User.TienePermiso(Permisos.Agregar)) { <a href="administracion/clientes" title="Abre Clientes y selecciona Nuevo cliente"><span>＋</span><span><strong>Nuevo cliente</strong><small>Desde el módulo de clientes</small></span><b>→</b></a> }
                <VistaConPermiso Permiso="@Permisos.Consultar"><a href="administracion/clientes"><span>♧</span><span><strong>Consultar clientes</strong><small>Explorar clientes</small></span><b>→</b></a></VistaConPermiso>
                <VistaConPermiso Permiso="@Permisos.GestionarCategorias"><a href="administracion/categorias-productos"><span>▤</span><span><strong>Gestionar categorías</strong><small>Organizar productos</small></span><b>→</b></a></VistaConPermiso>
                <VistaConPermiso Permiso="@Permisos.GestionarUsuarios"><a href="administracion/usuarios"><span>♙</span><span><strong>Gestionar usuarios</strong><small>Administrar accesos</small></span><b>→</b></a></VistaConPermiso>
                <VistaConPermiso Permiso="@Permisos.GestionarRoles"><a href="administracion/roles"><span>◇</span><span><strong>Gestionar roles</strong><small>Administrar permisos</small></span><b>→</b></a></VistaConPermiso>
                @if (!TieneAccesos(sesion.User)) { <p class="dash-empty">Tu rol no tiene acciones disponibles por ahora.</p> }
            </div></section>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="home-guest"><div class="guest-copy"><span class="dash-eyebrow">BIENVENIDO A SGECAR</span><h1>Tu gestión empresarial, en un solo lugar.</h1><p>Organiza productos, clientes y equipos con la información que necesitas para trabajar con claridad.</p><a href="login" class="guest-cta">Iniciar sesión <span aria-hidden="true">→</span></a></div><div class="guest-visual" aria-hidden="true"><div class="visual-top"><span>S</span><strong>SGECAR<small>Espacio de trabajo</small></strong></div><div class="visual-line wide"></div><div class="visual-line medium"></div><div class="visual-cards"><div>▣</div><div>♧</div><div>▤</div></div><div class="visual-line wide"></div><div class="visual-line short"></div></div></div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private readonly CancellationTokenSource cancelacion = new();
    private IReadOnlyList<ProductoResponse>? productos;
    private IReadOnlyList<ClienteResponse>? clientes;
    private IReadOnlyList<UsuarioResponse>? usuarios;
    private IReadOnlyList<CategoriaProductoResponse>? categorias;
    private bool cargandoProductos, cargandoClientes, cargandoUsuarios, cargandoCategorias;
    private string? errorProductos, errorClientes, errorUsuarios, errorCategorias;

    protected override async Task OnInitializedAsync()
    {
        var usuario = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        if (usuario.Identity?.IsAuthenticated != true) return;
        var tareas = new List<Task>();
        if (usuario.TienePermiso(Permisos.Consultar)) { cargandoProductos = true; tareas.Add(CargarProductosAsync()); }
        if (usuario.TienePermiso(Permisos.Consultar)) { cargandoClientes = true; tareas.Add(CargarClientesAsync()); }
        if (usuario.TienePermiso(Permisos.GestionarUsuarios)) { cargandoUsuarios = true; tareas.Add(CargarUsuariosAsync()); }
        if (usuario.TienePermiso(Permisos.GestionarCategorias)) { cargandoCategorias = true; tareas.Add(CargarCategoriasAsync()); }
        await Task.WhenAll(tareas);
    }
    private async Task CargarProductosAsync()
    {
        try { var r = await ProductosApi.ObtenerAsync(null, null, null, cancelacion.Token); if (r.Exito && r.Valor is not null) productos = r.Valor; else errorProductos = r.Mensaje; }
        catch (OperationCanceledException) when (cancelacion.IsCancellationRequested) { }
        finally { cargandoProductos = false; }
    }
    private async Task CargarClientesAsync()
    {
        try { var r = await ClientesApi.ObtenerAsync(null, null, null, cancelacion.Token); if (r.Exito && r.Valor is not null) clientes = r.Valor; else errorClientes = r.Mensaje; }
        catch (OperationCanceledException) when (cancelacion.IsCancellationRequested) { }
        finally { cargandoClientes = false; }
    }
    private async Task CargarUsuariosAsync()
    {
        try { var r = await UsuariosApi.ObtenerAsync(null, null, null, null, cancelacion.Token); if (r.Exito && r.Valor is not null) usuarios = r.Valor; else errorUsuarios = r.Mensaje; }
        catch (OperationCanceledException) when (cancelacion.IsCancellationRequested) { }
        finally { cargandoUsuarios = false; }
    }
    private async Task CargarCategoriasAsync()
    {
        try { var r = await CategoriasApi.ObtenerAsync(null, cancelacion.Token); if (r.Exito && r.Valor is not null) categorias = r.Valor; else errorCategorias = r.Mensaje; }
        catch (OperationCanceledException) when (cancelacion.IsCancellationRequested) { }
        finally { cargandoCategorias = false; }
    }
    private static string Valor<T>(IReadOnlyList<T>? lista, bool cargando, string? error) => cargando ? "…" : error is not null || lista is null ? "—" : lista.Count.ToString();
    private static string Valor(int? total, bool cargando, string? error) => cargando ? "…" : error is not null || total is null ? "—" : total.Value.ToString();
    private static string ClaseStock(int stock) => stock == 0 ? "out" : stock <= 5 ? "low" : "normal";
    private static bool TieneAccesos(System.Security.Claims.ClaimsPrincipal usuario) => usuario.TienePermiso(Permisos.Consultar) || usuario.TienePermiso(Permisos.GestionarCategorias) || usuario.TienePermiso(Permisos.GestionarUsuarios) || usuario.TienePermiso(Permisos.GestionarRoles);
    public void Dispose() { cancelacion.Cancel(); cancelacion.Dispose(); }
}
