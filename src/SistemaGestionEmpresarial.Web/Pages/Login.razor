@page "/login"
@inject SistemaGestionEmpresarial.Web.Services.AuthApiService AuthApi
@inject SistemaGestionEmpresarial.Web.Services.ApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>Iniciar Sesión - SGECAR</PageTitle>

<div class="login-wrapper">
    <div class="login-card">
        <!-- Barra de Estado API en Vivo -->
        <div class="api-status-pill @(apiConectada ? "status-online" : "status-offline")" title="Estado de comunicación con el backend API">
            <span class="status-dot"></span>
            <span>@(apiConectada ? "API Conectada" : "API Desconectada")</span>
        </div>

        <div class="login-header">
            <div class="logo-box">
                <span class="logo-icon">🏢</span>
            </div>
            <h2>Bienvenido a SGECAR</h2>
            <p class="subtitle">Sistema de Gestión Empresarial con Control de Acceso por Roles</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(mensajeError))
        {
            <div class="alert alert-danger" role="alert">
                <span class="alert-icon">⚠️</span>
                <div>
                    <strong>Error de acceso</strong>
                    <p>@mensajeError</p>
                </div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(mensajeExito))
        {
            <div class="alert alert-success" role="alert">
                <span class="alert-icon">✓</span>
                <div>
                    <strong>¡Autenticado!</strong>
                    <p>@mensajeExito</p>
                </div>
            </div>
        }

        <form @onsubmit="IniciarSesionAsync" @onsubmit:preventDefault class="login-form">
            <div class="form-group">
                <label for="username">Usuario</label>
                <div class="input-wrapper">
                    <span class="input-icon">👤</span>
                    <input id="username" 
                           type="text" 
                           class="form-control" 
                           placeholder="Ingresa tu usuario (ej. admin)" 
                           @bind="loginModel.Username" 
                           disabled="@cargando" 
                           autocomplete="username" />
                </div>
            </div>

            <div class="form-group">
                <label for="password">Contraseña</label>
                <div class="input-wrapper">
                    <span class="input-icon">🔒</span>
                    <input id="password" 
                           type="@(mostrarContrasena ? "text" : "password")" 
                           class="form-control" 
                           placeholder="Ingresa tu contraseña" 
                           @bind="loginModel.Password" 
                           disabled="@cargando" 
                           autocomplete="current-password" />
                    <button type="button" 
                            class="btn-toggle-eye" 
                            @onclick="ToggleMostrarContrasena" 
                            tabindex="-1"
                            title="@(mostrarContrasena ? "Ocultar" : "Mostrar") contraseña">
                        @(mostrarContrasena ? "🙈" : "👁️")
                    </button>
                </div>
            </div>

            <div class="form-options">
                <label class="checkbox-container">
                    <input type="checkbox" @bind="mostrarContrasena" />
                    <span class="checkmark"></span>
                    Mostrar contraseña
                </label>
            </div>

            <button type="submit" class="btn btn-submit" disabled="@cargando">
                @if (cargando)
                {
                    <span class="spinner-small"></span>
                    <span>Validando credenciales...</span>
                }
                else
                {
                    <span>Iniciar Sesión</span>
                }
            </button>
        </form>

        <!-- Accesos rápidos para demostración / defensa práctica -->
        <div class="demo-box">
            <div class="demo-header">
                <span class="demo-badge">Demo</span>
                <span>Probar credenciales predeterminadas:</span>
            </div>
            <div class="demo-buttons">
                <button type="button" class="btn-demo demo-admin" @onclick='() => AutoLlenar("admin", "admin123")' title="Rol: Administrador (Acceso total)">
                    👑 Admin
                </button>
                <button type="button" class="btn-demo demo-supervisor" @onclick='() => AutoLlenar("supervisor", "supervisor123")' title="Rol: Supervisor (Consultar y Modificar)">
                    📋 Supervisor
                </button>
                <button type="button" class="btn-demo demo-ejecutor" @onclick='() => AutoLlenar("ejecutor", "ejecutor123")' title="Rol: Ejecutor (Consultar y Agregar)">
                    ⚙️ Ejecutor
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .login-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 80vh;
        padding: 30px 16px;
    }

    .login-card {
        position: relative;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 36px 32px;
        width: 100%;
        max-width: 440px;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.08), 0 8px 10px -6px rgba(0, 0, 0, 0.04);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    /* Pill superior con estado API */
    .api-status-pill {
        position: absolute;
        top: 16px;
        right: 16px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .status-online {
        background-color: #ecfdf5;
        color: #047857;
        border: 1px solid #a7f3d0;
    }

    .status-online .status-dot {
        background-color: #10b981;
        box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.2);
    }

    .status-offline {
        background-color: #fef2f2;
        color: #b91c1c;
        border: 1px solid #fecaca;
    }

    .status-offline .status-dot {
        background-color: #ef4444;
    }

    .status-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        display: inline-block;
    }

    .login-header {
        text-align: center;
        margin-bottom: 24px;
        margin-top: 8px;
    }

    .logo-box {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 56px;
        height: 56px;
        background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
        border: 1px solid #bfdbfe;
        border-radius: 14px;
        margin-bottom: 14px;
        box-shadow: 0 4px 6px -1px rgba(37, 99, 235, 0.1);
    }

    .logo-icon {
        font-size: 1.8rem;
    }

    .login-header h2 {
        margin: 0 0 6px 0;
        font-size: 1.45rem;
        font-weight: 800;
        color: #0f172a;
        letter-spacing: -0.02em;
    }

    .login-header .subtitle {
        margin: 0;
        font-size: 0.85rem;
        color: #64748b;
        line-height: 1.4;
    }

    .login-form {
        margin-top: 12px;
    }

    .form-group {
        margin-bottom: 18px;
    }

    .form-group label {
        display: block;
        margin-bottom: 6px;
        font-size: 0.88rem;
        font-weight: 600;
        color: #334155;
    }

    .input-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }

    .input-icon {
        position: absolute;
        left: 12px;
        font-size: 1rem;
        color: #94a3b8;
        pointer-events: none;
    }

    .form-control {
        width: 100%;
        padding: 11px 40px 11px 38px;
        font-size: 0.95rem;
        font-family: inherit;
        color: #0f172a;
        background-color: #f8fafc;
        border: 1.5px solid #e2e8f0;
        border-radius: 8px;
        box-sizing: border-box;
        transition: all 0.2s ease;
    }

    .form-control:focus {
        background-color: #ffffff;
        border-color: #2563eb;
        outline: none;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
    }

    .form-control:disabled {
        background-color: #f1f5f9;
        cursor: not-allowed;
    }

    .btn-toggle-eye {
        position: absolute;
        right: 10px;
        background: none;
        border: none;
        cursor: pointer;
        font-size: 1.1rem;
        padding: 4px 6px;
        opacity: 0.7;
        transition: opacity 0.2s;
    }

    .btn-toggle-eye:hover {
        opacity: 1;
    }

    .form-options {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 22px;
        font-size: 0.85rem;
        color: #475569;
    }

    .checkbox-container {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
        user-select: none;
    }

    .checkbox-container input {
        cursor: pointer;
        width: 16px;
        height: 16px;
    }

    .btn-submit {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        width: 100%;
        padding: 13px 20px;
        font-size: 1rem;
        font-weight: 700;
        color: #ffffff;
        background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
        border: none;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.2s ease;
        box-shadow: 0 4px 10px rgba(37, 99, 235, 0.25);
    }

    .btn-submit:hover:not(:disabled) {
        background: linear-gradient(135deg, #1d4ed8 0%, #1e40af 100%);
        transform: translateY(-1px);
        box-shadow: 0 6px 14px rgba(37, 99, 235, 0.35);
    }

    .btn-submit:disabled {
        background: #94a3b8;
        cursor: not-allowed;
        box-shadow: none;
    }

    .alert {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 12px 16px;
        border-radius: 8px;
        margin-bottom: 18px;
        font-size: 0.88rem;
        animation: fadeIn 0.3s ease;
    }

    .alert-icon {
        font-size: 1.2rem;
        line-height: 1;
    }

    .alert strong {
        display: block;
        font-size: 0.85rem;
        margin-bottom: 2px;
    }

    .alert p {
        margin: 0;
        line-height: 1.35;
    }

    .alert-danger {
        background-color: #fef2f2;
        border: 1px solid #fecaca;
        color: #991b1b;
    }

    .alert-success {
        background-color: #ecfdf5;
        border: 1px solid #a7f3d0;
        color: #065f46;
    }

    .demo-box {
        margin-top: 26px;
        padding: 14px 16px;
        background-color: #f8fafc;
        border: 1px dashed #cbd5e1;
        border-radius: 10px;
    }

    .demo-header {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.8rem;
        color: #64748b;
        font-weight: 600;
        margin-bottom: 10px;
    }

    .demo-badge {
        background-color: #e2e8f0;
        color: #334155;
        padding: 2px 6px;
        border-radius: 4px;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
    }

    .demo-buttons {
        display: flex;
        gap: 6px;
    }

    .btn-demo {
        flex: 1;
        padding: 6px 10px;
        border-radius: 6px;
        border: 1px solid #e2e8f0;
        background-color: #ffffff;
        font-size: 0.8rem;
        font-weight: 600;
        color: #334155;
        cursor: pointer;
        transition: all 0.15s ease;
    }

    .btn-demo:hover {
        background-color: #f1f5f9;
        border-color: #94a3b8;
        transform: translateY(-1px);
    }

    .demo-admin:hover {
        border-color: #059669;
        color: #059669;
    }

    .demo-supervisor:hover {
        border-color: #d97706;
        color: #d97706;
    }

    .demo-ejecutor:hover {
        border-color: #2563eb;
        color: #2563eb;
    }

    .spinner-small {
        width: 16px;
        height: 16px;
        border: 2px solid rgba(255, 255, 255, 0.3);
        border-top-color: #ffffff;
        border-radius: 50%;
        display: inline-block;
        animation: spin 0.8s linear infinite;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(-4px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

@code {
    private SistemaGestionEmpresarial.Contracts.LoginRequest loginModel = new();
    private bool mostrarContrasena = false;
    private bool cargando = false;
    private bool apiConectada = false;
    private string? mensajeError;
    private string? mensajeExito;

    protected override async Task OnInitializedAsync()
    {
        // Comprobación rápida y silenciosa de la API para encender el indicador
        try
        {
            var res = await ApiClient.CheckHealthAsync();
            apiConectada = res?.Status == "ok";
        }
        catch
        {
            apiConectada = false;
        }
    }

    private void ToggleMostrarContrasena()
    {
        mostrarContrasena = !mostrarContrasena;
    }

    private void AutoLlenar(string usuario, string clave)
    {
        loginModel.Username = usuario;
        loginModel.Password = clave;
        mensajeError = null;
    }

    private async Task IniciarSesionAsync()
    {
        mensajeError = null;
        mensajeExito = null;

        // 1. Validación de campos vacíos en cliente
        if (string.IsNullOrWhiteSpace(loginModel.Username))
        {
            mensajeError = "Por favor, ingrese el nombre de usuario.";
            return;
        }

        if (string.IsNullOrWhiteSpace(loginModel.Password))
        {
            mensajeError = "Por favor, ingrese la contraseña.";
            return;
        }

        cargando = true;

        try
        {
            // 2. Delegación a AuthApiService
            var resultado = await AuthApi.LoginAsync(loginModel);

            if (resultado.Success)
            {
                mensajeExito = resultado.Message ?? "Autenticación exitosa. Redirigiendo...";
                await Task.Delay(350);
                Navigation.NavigateTo("/");
            }
            else
            {
                mensajeError = resultado.Message ?? "Usuario o contraseña incorrectos.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error de comunicación con el servicio: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }
}
