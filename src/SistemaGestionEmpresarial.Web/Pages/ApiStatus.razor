@page "/api-status"
@inject SistemaGestionEmpresarial.Web.Services.ApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>Estado de la API - SGECAR</PageTitle>

<div class="status-container">
    <div class="status-card">
        <div class="status-header">
            <div class="header-icon @(estado == EstadoConexion.Conectado ? "icon-success" : (estado == EstadoConexion.Error ? "icon-danger" : "icon-neutral"))">
                @(estado == EstadoConexion.Conectado ? "🟢" : (estado == EstadoConexion.Error ? "🔴" : "⚡"))
            </div>
            <div>
                <h2>Diagnóstico de Conexión</h2>
                <p class="status-sub">Verificación de comunicación entre Blazor WebAssembly y ASP.NET Core Web API</p>
            </div>
        </div>

        <div class="status-body">
            <!-- Botón Principal con el Requerimiento: Verde cuando está conectado -->
            <div class="action-section">
                <button class="status-btn @ClaseBoton" @onclick="ProbarConexionAsync" disabled="@verificando">
                    @if (verificando)
                    {
                        <span class="spinner-dot"></span>
                        <span>Verificando disponibilidad...</span>
                    }
                    else if (estado == EstadoConexion.Conectado)
                    {
                        <span class="pulse-dot"></span>
                        <span class="btn-text">✓ Conectado</span>
                    }
                    else if (estado == EstadoConexion.Error)
                    {
                        <span class="cross-icon">✕</span>
                        <span class="btn-text">Desconectado (Reintentar)</span>
                    }
                    else
                    {
                        <span>🔌 Probar Conexión</span>
                    }
                </button>
            </div>

            <!-- Panel de Detalles Técnicos -->
            <div class="details-box @(estado == EstadoConexion.Conectado ? "box-success" : (estado == EstadoConexion.Error ? "box-danger" : "box-neutral"))">
                <div class="detail-row">
                    <span class="detail-label">Servicio Backend:</span>
                    <span class="detail-value font-mono">http://localhost:5080/api/health</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Estado de Respuesta:</span>
                    <span class="detail-value">
                        @if (estado == EstadoConexion.Conectado)
                        {
                            <span class="badge-tag tag-success">API Conectada (Respuesta: "@(respuestaTexto ?? "ok")")</span>
                        }
                        else if (estado == EstadoConexion.Error)
                        {
                            <span class="badge-tag tag-danger">Sin Conexión con el Servidor</span>
                        }
                        else
                        {
                            <span class="badge-tag tag-neutral">Pendiente de verificación</span>
                        }
                    </span>
                </div>
                @if (latenciaMs.HasValue)
                {
                    <div class="detail-row">
                        <span class="detail-label">Tiempo de Respuesta:</span>
                        <span class="detail-value">@latenciaMs ms</span>
                    </div>
                }
                @if (ultimaVerificacion.HasValue)
                {
                    <div class="detail-row">
                        <span class="detail-label">Última comprobación:</span>
                        <span class="detail-value">@ultimaVerificacion.Value.ToString("T")</span>
                    </div>
                }
            </div>

            @if (estado == EstadoConexion.Error && !string.IsNullOrWhiteSpace(mensajeDetalle))
            {
                <div class="tip-card">
                    <strong>Sugerencia de solución:</strong>
                    <p>Asegúrate de que la API esté corriendo en la terminal con:</p>
                    <code>dotnet run --project src/SistemaGestionEmpresarial.Api --launch-profile "http"</code>
                </div>
            }

            <div class="navigation-footer">
                <a href="/" class="btn-link">← Volver al Inicio</a>
                <a href="login" class="btn-link btn-link-primary">Ir a Iniciar Sesión →</a>
            </div>
        </div>
    </div>
</div>

<style>
    .status-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 75vh;
        padding: 20px;
    }

    .status-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        width: 100%;
        max-width: 560px;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
        overflow: hidden;
    }

    .status-header {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 24px 28px;
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
    }

    .header-icon {
        font-size: 2rem;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 52px;
        height: 52px;
        border-radius: 12px;
        background: #ffffff;
        border: 1px solid #e2e8f0;
    }

    .header-icon.icon-success {
        background: #ecfdf5;
        border-color: #a7f3d0;
    }

    .header-icon.icon-danger {
        background: #fef2f2;
        border-color: #fecaca;
    }

    .status-header h2 {
        margin: 0 0 4px 0;
        font-size: 1.25rem;
        color: #0f172a;
        font-weight: 700;
    }

    .status-sub {
        margin: 0;
        font-size: 0.85rem;
        color: #64748b;
    }

    .status-body {
        padding: 28px;
    }

    .action-section {
        margin-bottom: 24px;
        text-align: center;
    }

    /* Estilos del Botón Reactivo (Verde al estar conectado) */
    .status-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        width: 100%;
        padding: 14px 24px;
        font-size: 1.05rem;
        font-weight: 700;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.25s ease;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    }

    .status-btn.btn-connected {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: #ffffff;
        box-shadow: 0 6px 14px rgba(16, 185, 129, 0.35);
    }

    .status-btn.btn-connected:hover {
        background: linear-gradient(135deg, #059669 0%, #047857 100%);
        transform: translateY(-1px);
        box-shadow: 0 8px 18px rgba(16, 185, 129, 0.45);
    }

    .status-btn.btn-disconnected {
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        color: #ffffff;
        box-shadow: 0 4px 12px rgba(239, 68, 68, 0.3);
    }

    .status-btn.btn-disconnected:hover {
        background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%);
        transform: translateY(-1px);
    }

    .status-btn.btn-default {
        background: #2563eb;
        color: #ffffff;
    }

    .status-btn.btn-default:hover {
        background: #1d4ed8;
    }

    .status-btn:disabled {
        opacity: 0.75;
        cursor: wait;
    }

    /* Punto verde pulsante para el botón conectado */
    .pulse-dot {
        width: 10px;
        height: 10px;
        background-color: #ffffff;
        border-radius: 50%;
        display: inline-block;
        box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.7);
        animation: pulse 1.6s infinite;
    }

    @@keyframes pulse {
        0% {
            transform: scale(0.95);
            box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.7);
        }
        70% {
            transform: scale(1);
            box-shadow: 0 0 0 8px rgba(255, 255, 255, 0);
        }
        100% {
            transform: scale(0.95);
            box-shadow: 0 0 0 0 rgba(255, 255, 255, 0);
        }
    }

    .details-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 16px 20px;
        margin-bottom: 20px;
        font-size: 0.9rem;
    }

    .details-box.box-success {
        border-color: #a7f3d0;
        background-color: #f0fdf4;
    }

    .details-box.box-danger {
        border-color: #fecaca;
        background-color: #fef2f2;
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 8px 0;
        border-bottom: 1px dashed rgba(0, 0, 0, 0.08);
    }

    .detail-row:last-child {
        border-bottom: none;
    }

    .detail-label {
        color: #64748b;
        font-weight: 500;
    }

    .detail-value {
        color: #0f172a;
        font-weight: 600;
    }

    .font-mono {
        font-family: monospace;
        font-size: 0.85rem;
    }

    .badge-tag {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .tag-success {
        background: #dcfce7;
        color: #166534;
    }

    .tag-danger {
        background: #fee2e2;
        color: #991b1b;
    }

    .tag-neutral {
        background: #e2e8f0;
        color: #475569;
    }

    .tip-card {
        background: #fffbeb;
        border: 1px solid #fde68a;
        border-radius: 8px;
        padding: 14px 18px;
        margin-bottom: 20px;
        font-size: 0.85rem;
        color: #92400e;
    }

    .tip-card p {
        margin: 4px 0 6px 0;
    }

    .tip-card code {
        display: block;
        background: #fef3c7;
        padding: 6px 10px;
        border-radius: 4px;
        font-family: monospace;
        color: #78350f;
    }

    .navigation-footer {
        display: flex;
        justify-content: space-between;
        padding-top: 14px;
        border-top: 1px solid #f1f5f9;
    }

    .btn-link {
        color: #475569;
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 500;
        transition: color 0.2s;
    }

    .btn-link:hover {
        color: #0f172a;
    }

    .btn-link-primary {
        color: #2563eb;
        font-weight: 600;
    }

    .btn-link-primary:hover {
        color: #1d4ed8;
    }
</style>

@code {
    private enum EstadoConexion { Inicial, Verificando, Conectado, Error }

    private EstadoConexion estado = EstadoConexion.Inicial;
    private bool verificando => estado == EstadoConexion.Verificando;
    private string? respuestaTexto;
    private string? mensajeDetalle;
    private long? latenciaMs;
    private DateTime? ultimaVerificacion;

    private string ClaseBoton => estado switch
    {
        EstadoConexion.Conectado => "btn-connected",
        EstadoConexion.Error => "btn-disconnected",
        _ => "btn-default"
    };

    protected override async Task OnInitializedAsync()
    {
        // Comprobar automáticamente al ingresar a la página
        await ProbarConexionAsync();
    }

    private async Task ProbarConexionAsync()
    {
        estado = EstadoConexion.Verificando;
        mensajeDetalle = null;
        var stopwatch = System.Diagnostics.Stopwatch.StartNew();

        try
        {
            var respuesta = await ApiClient.CheckHealthAsync();
            stopwatch.Stop();
            latenciaMs = stopwatch.ElapsedMilliseconds;
            ultimaVerificacion = DateTime.Now;

            if (respuesta.Status == "ok")
            {
                estado = EstadoConexion.Conectado;
                respuestaTexto = respuesta.Status;
            }
            else
            {
                estado = EstadoConexion.Error;
                mensajeDetalle = "La API respondió, pero el estado no fue 'ok'.";
            }
        }
        catch (Exception ex)
        {
            stopwatch.Stop();
            latenciaMs = null;
            ultimaVerificacion = DateTime.Now;
            estado = EstadoConexion.Error;
            mensajeDetalle = ex.Message;
        }
    }
}
