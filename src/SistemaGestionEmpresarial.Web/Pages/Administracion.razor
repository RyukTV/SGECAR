@page "/administracion"
@attribute [Authorize(Policy = PoliticasDePermiso.PanelAdministrativo)]
@inject PermisosApiService PermisosApi
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Administración - SGECAR</PageTitle>

<div class="admin-wrapper">
    <header class="admin-header">
        <h1>Administración del sistema</h1>
        <p>Módulos administrativos disponibles según los permisos de su rol.</p>
    </header>

    @if (!cargando && !tieneModulos)
    {
        <p class="estado" role="status">Su rol no tiene módulos disponibles por ahora.</p>
    }

    <div class="gestion-cards">
        <VistaConPermiso Permiso="@Permisos.GestionarUsuarios">
            <a class="gestion-card" href="/administracion/usuarios">
                <h2>Gestión de Usuarios</h2>
                <p>Consultar, buscar, crear, modificar, activar y eliminar usuarios.</p>
            </a>
        </VistaConPermiso>
        <VistaConPermiso Permiso="@Permisos.GestionarRoles">
            <a class="gestion-card" href="/administracion/roles">
                <h2>Gestión de Roles</h2>
                <p>Administrar roles y los @Permisos.Todos.Count permisos almacenados en SQL Server.</p>
            </a>
        </VistaConPermiso>
        <VistaConPermiso Permiso="@Permisos.GestionarCategorias">
            <a class="gestion-card" href="/administracion/categorias-productos">
                <h2>Categorías de Productos</h2>
                <p>Registrar, buscar, modificar y eliminar categorías del inventario.</p>
            </a>
        </VistaConPermiso>
    </div>

    @if (puedeGestionarRoles)
    {
        @if (cargando)
        {
            <p class="estado" role="status">Cargando la matriz de permisos…</p>
        }
        else if (catalogo is null)
        {
            <div class="estado estado-error" role="alert">
                No fue posible obtener la matriz de permisos. Verifique que la API esté disponible
                y que su rol conserve el permiso de gestión de roles.
            </div>
        }
        else
        {
            <div class="tabla-scroll">
                <table class="tabla-permisos">
                <thead>
                    <tr>
                        <th scope="col">Rol</th>
                        @foreach (var permiso in Permisos.Todos)
                        {
                            <th scope="col">@permiso</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var fila in catalogo)
                    {
                        <tr>
                            <th scope="row">@fila.Rol</th>
                            @foreach (var permiso in Permisos.Todos)
                            {
                                var concedido = fila.Permisos.Contains(permiso);
                                <td class="@(concedido ? "si" : "no")">
                                    <span title="@(concedido ? $"{fila.Rol} puede {Permisos.Describir(permiso)}" : $"{fila.Rol} no puede {Permisos.Describir(permiso)}")">
                                        @(concedido ? "Sí" : "No")
                                    </span>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
                </table>
            </div>

            <p class="nota">La matriz refleja los permisos almacenados actualmente en SQL Server.</p>
        }
    }
</div>

<style>
    .admin-wrapper {
        max-width: 1200px;
        margin: 0 auto;
        animation: sgecar-enter 220ms ease-out both;
    }

    .admin-header h1 {
        margin: 0 0 8px;
        font-size: clamp(1.5rem, 2.5vw, 1.8rem);
        font-weight: 800;
        letter-spacing: -0.03em;
        color: var(--color-text-primary);
    }

    .admin-header p {
        margin: 0 0 24px;
        max-width: 640px;
        color: var(--color-text-secondary);
        line-height: 1.55;
        font-size: 0.9rem;
    }

    .estado {
        padding: 14px 16px;
        border-radius: 10px;
        background-color: var(--color-surface);
        border: 1px solid var(--color-border);
        color: var(--color-text-secondary);
        font-size: 0.88rem;
    }

    .estado-error {
        background-color: var(--color-danger-light);
        border-color: var(--color-danger-border);
        color: #991b1b;
    }

    .tabla-scroll {
        overflow-x: auto;
        background-color: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 14px;
        box-shadow: 0 2px 9px rgba(15, 23, 42, .035);
    }

    .tabla-permisos {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.85rem;
    }

    .tabla-permisos th,
    .tabla-permisos td {
        padding: 13px 16px;
        text-align: left;
        border-bottom: 1px solid var(--color-border);
        white-space: nowrap;
    }

    .tabla-permisos thead th {
        font-size: 0.71rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: #64748b;
        background-color: #f8fafc;
    }

    .tabla-permisos tbody tr {
        transition: background-color 140ms ease;
    }

    .tabla-permisos tbody tr:hover {
        background-color: #f8fafc;
    }

    .tabla-permisos tbody th {
        font-weight: 700;
        color: var(--color-text-primary);
    }

    .tabla-permisos tbody tr:last-child th,
    .tabla-permisos tbody tr:last-child td {
        border-bottom: none;
    }

    .tabla-permisos td.si {
        color: var(--color-success-hover);
        font-weight: 700;
    }

    .tabla-permisos td.no {
        color: var(--color-text-muted);
    }

    .nota {
        margin-top: 18px;
        font-size: 0.82rem;
        color: var(--color-text-muted);
        line-height: 1.55;
    }

    .nota code {
        padding: 1px 5px;
        border-radius: 4px;
        background-color: var(--color-surface-hover);
        border: 1px solid var(--color-border);
        font-size: 0.78rem;
    }
</style>

@code {
    private IReadOnlyList<RolPermisosResponse>? catalogo;
    private bool cargando = true;
    private bool puedeGestionarRoles;
    private bool tieneModulos;

    protected override async Task OnInitializedAsync()
    {
        var estado = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        puedeGestionarRoles = estado.User.TienePermiso(Permisos.GestionarRoles);
        // Mismos permisos que controlan las tarjetas de arriba.
        tieneModulos = puedeGestionarRoles
            || estado.User.TienePermiso(Permisos.GestionarUsuarios)
            || estado.User.TienePermiso(Permisos.GestionarCategorias);
        if (puedeGestionarRoles)
            catalogo = await PermisosApi.ObtenerCatalogoAsync();
        cargando = false;
    }
}
