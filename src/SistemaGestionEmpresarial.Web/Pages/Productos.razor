@page "/administracion/productos"
@attribute [Authorize(Policy = PoliticasDePermiso.Consultar)]
@inject ProductosApiService ProductosApi
@inject IJSRuntime JS

<PageTitle>Gestión de Productos - SGECAR</PageTitle>

<div class="gestion-wrapper">
    <header class="gestion-header">
        <div>
            <a href="/administracion" class="gestion-volver">← Administración</a>
            <h1>Mantenimiento de Productos</h1>
            <p>Registre, consulte y mantenga el inventario de productos.</p>
        </div>
        <div class="gestion-actions">
            <a class="gestion-btn gestion-btn-light" href="/reportes/productos">Reporte de productos</a>
            <VistaConPermiso Permiso="@Permisos.Agregar">
                <button class="gestion-btn gestion-btn-primary" @onclick="PrepararCreacion">Nuevo producto</button>
            </VistaConPermiso>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(mensaje))
    {
        <div class="gestion-alert @(esError ? "gestion-alert-error" : "gestion-alert-ok")" role="alert">@mensaje</div>
    }

    <form class="gestion-panel" @onsubmit="BuscarAsync" @onsubmit:preventDefault>
        <h2>Buscar productos</h2>
        <div class="gestion-grid productos-filtros">
            <label>Código o ID
                <input @bind="codigoOId" placeholder="Ej. PRD-001 o 1" />
            </label>
            <label>Nombre
                <input @bind="nombreFiltro" placeholder="Ej. Teclado" />
            </label>
            <label>Categoría
                <select @bind="categoriaIdFiltro">
                    <option value="0">Todas las categorías</option>
                    @foreach (var categoria in categorias)
                    {
                        <option value="@categoria.Id">@categoria.Nombre</option>
                    }
                </select>
            </label>
        </div>
        <div class="gestion-actions">
            <button class="gestion-btn gestion-btn-primary" type="submit" disabled="@cargando">Buscar</button>
            <button class="gestion-btn gestion-btn-light" type="button" @onclick="LimpiarFiltrosAsync" disabled="@cargando">Limpiar filtros</button>
        </div>
    </form>

    @if (mostrarFormulario)
    {
        <section class="gestion-panel" id="formulario-producto">
            <h2>@(idEdicion.HasValue ? "Modificar producto" : "Registrar producto")</h2>
            <EditForm Model="formulario" OnValidSubmit="GuardarAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="gestion-grid">
                    <label>Código
                        <InputText @bind-Value="formulario.Codigo" />
                    </label>
                    <label>Nombre
                        <InputText @bind-Value="formulario.Nombre" />
                    </label>
                    <label>Precio
                        <InputNumber @bind-Value="formulario.Precio" step="0.01" />
                    </label>
                    <label>Stock
                        <InputNumber @bind-Value="formulario.Stock" />
                    </label>
                    <label>Categoría
                        <InputSelect @bind-Value="formulario.CategoriaId">
                            <option value="0">Seleccione una categoría</option>
                            @foreach (var categoria in categorias)
                            {
                                <option value="@categoria.Id">@categoria.Nombre</option>
                            }
                        </InputSelect>
                    </label>
                </div>
                <div class="gestion-actions">
                    <button class="gestion-btn gestion-btn-primary" type="submit" disabled="@guardando">Guardar</button>
                    <button class="gestion-btn gestion-btn-light" type="button" @onclick="LimpiarCampos">Limpiar campos</button>
                    <button class="gestion-btn gestion-btn-light" type="button" @onclick="CancelarFormulario">Cancelar</button>
                </div>
            </EditForm>
        </section>
    }

    @if (cargando)
    {
        <p class="gestion-estado" role="status">Cargando productos…</p>
    }
    else if (productos.Count == 0)
    {
        <p class="gestion-estado">No se encontraron productos.</p>
    }
    else
    {
        <div class="gestion-tabla-scroll">
            <table class="gestion-tabla">
                <thead>
                    <tr><th>ID</th><th>Código</th><th>Nombre</th><th>Precio</th><th>Stock</th><th>Categoría</th><th>Acciones</th></tr>
                </thead>
                <tbody>
                    @foreach (var producto in productos)
                    {
                        <tr>
                            <td>@producto.Id</td>
                            <td><strong>@producto.Codigo</strong></td>
                            <td>@producto.Nombre</td>
                            <td>RD$ @producto.Precio.ToString("N2")</td>
                            <td>@producto.Stock</td>
                            <td>@producto.Categoria</td>
                            <td class="gestion-actions-tabla">
                                <VistaConPermiso Permiso="@Permisos.Modificar">
                                    <button class="gestion-btn gestion-btn-small" @onclick="() => PrepararEdicion(producto)">Modificar</button>
                                </VistaConPermiso>
                                <VistaConPermiso Permiso="@Permisos.Eliminar">
                                    <button class="gestion-btn gestion-btn-danger gestion-btn-small" @onclick="() => EliminarAsync(producto)">Eliminar</button>
                                </VistaConPermiso>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<ProductoResponse> productos = [];
    private List<CategoriaProductoResponse> categorias = [];
    private ProductoForm formulario = new();
    private int? idEdicion;
    private string codigoOId = string.Empty;
    private string nombreFiltro = string.Empty;
    private int categoriaIdFiltro;
    private string? mensaje;
    private bool esError;
    private bool cargando = true;
    private bool guardando;
    private bool mostrarFormulario;

    protected override async Task OnInitializedAsync()
    {
        await CargarCategoriasAsync();
        await CargarProductosAsync();
    }

    private async Task CargarCategoriasAsync()
    {
        var resultado = await ProductosApi.ObtenerCategoriasDisponiblesAsync();
        if (resultado.Exito)
            categorias = resultado.Valor!.ToList();
        else
            MostrarMensaje(resultado.Mensaje, true);
    }

    private async Task CargarProductosAsync()
    {
        cargando = true;
        var resultado = await ProductosApi.ObtenerAsync(
            codigoOId, nombreFiltro, categoriaIdFiltro > 0 ? categoriaIdFiltro : null);
        if (resultado.Exito)
            productos = resultado.Valor!.ToList();
        else
            MostrarMensaje(resultado.Mensaje, true);
        cargando = false;
    }

    private Task BuscarAsync() => CargarProductosAsync();

    private async Task LimpiarFiltrosAsync()
    {
        codigoOId = string.Empty;
        nombreFiltro = string.Empty;
        categoriaIdFiltro = 0;
        await CargarProductosAsync();
    }

    private void PrepararCreacion()
    {
        idEdicion = null;
        formulario = new ProductoForm();
        mostrarFormulario = true;
        mensaje = null;
    }

    private void PrepararEdicion(ProductoResponse producto)
    {
        idEdicion = producto.Id;
        formulario = new ProductoForm
        {
            Codigo = producto.Codigo,
            Nombre = producto.Nombre,
            Precio = producto.Precio,
            Stock = producto.Stock,
            CategoriaId = producto.CategoriaId
        };
        mostrarFormulario = true;
        mensaje = null;
    }

    private void LimpiarCampos()
    {
        formulario = new ProductoForm();
        mensaje = null;
    }

    private void CancelarFormulario()
    {
        mostrarFormulario = false;
        formulario = new ProductoForm();
        idEdicion = null;
    }

    private async Task GuardarAsync()
    {
        guardando = true;
        ResultadoApi<ProductoResponse> resultado;

        if (idEdicion.HasValue)
        {
            resultado = await ProductosApi.ActualizarAsync(idEdicion.Value, new ActualizarProductoRequest
            {
                Codigo = formulario.Codigo,
                Nombre = formulario.Nombre,
                Precio = formulario.Precio,
                Stock = formulario.Stock,
                CategoriaId = formulario.CategoriaId
            });
        }
        else
        {
            resultado = await ProductosApi.CrearAsync(new CrearProductoRequest
            {
                Codigo = formulario.Codigo,
                Nombre = formulario.Nombre,
                Precio = formulario.Precio,
                Stock = formulario.Stock,
                CategoriaId = formulario.CategoriaId
            });
        }

        guardando = false;
        if (!resultado.Exito)
        {
            MostrarMensaje(resultado.Mensaje, true);
            return;
        }

        MostrarMensaje(idEdicion.HasValue ? "Producto actualizado correctamente." : "Producto creado correctamente.", false);
        mostrarFormulario = false;
        formulario = new ProductoForm();
        idEdicion = null;
        await CargarProductosAsync();
    }

    private async Task EliminarAsync(ProductoResponse producto)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"¿Eliminar el producto '{producto.Codigo} - {producto.Nombre}'?"))
            return;

        var resultado = await ProductosApi.EliminarAsync(producto.Id);
        MostrarMensaje(resultado.Mensaje, !resultado.Exito);
        if (resultado.Exito)
            await CargarProductosAsync();
    }

    private void MostrarMensaje(string texto, bool error)
    {
        mensaje = texto;
        esError = error;
    }

    private sealed class ProductoForm
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "El código es obligatorio.")]
        [System.ComponentModel.DataAnnotations.MaxLength(50, ErrorMessage = "El código no puede superar 50 caracteres.")]
        public string Codigo { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "El nombre es obligatorio.")]
        [System.ComponentModel.DataAnnotations.MaxLength(150, ErrorMessage = "El nombre no puede superar 150 caracteres.")]
        public string Nombre { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Range(typeof(decimal), "0.01", "9999999999999999", ErrorMessage = "El precio debe ser mayor que 0.")]
        public decimal Precio { get; set; }

        [System.ComponentModel.DataAnnotations.Range(0, int.MaxValue, ErrorMessage = "El stock debe ser mayor o igual a 0.")]
        public int Stock { get; set; }

        [System.ComponentModel.DataAnnotations.Range(1, int.MaxValue, ErrorMessage = "Debe seleccionar una categoría.")]
        public int CategoriaId { get; set; }
    }
}
